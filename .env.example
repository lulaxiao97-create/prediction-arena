# ── Deployer ─────────────────────────────────────────────────────────────────
# Private key of the deployer / owner wallet (never commit a real key).
# Use a hardware wallet or a dedicated deployer key, then transfer ownership.
PRIVATE_KEY=0x436b9d5e6fBd40eC93E881263bE53e59F8755Ba1

# ── Profit receiver ──────────────────────────────────────────────────────────
# feeVault: receives 100% of the platform rake (net of KOL commission).
# Must be a multilingual/hardware wallet address you control. No zero address.
FEE_RECEIVER=0x9520269b506e02c357a712160979a3237C404fE6

# ── Base RPC ─────────────────────────────────────────────────────────────────
# Public endpoint works for testing; use Alchemy/QuickNode/Infura in production.
BASE_RPC_URL=https://mainnet.base.org

# ── Optional ─────────────────────────────────────────────────────────────────
# Override the canonical USDC address (defaults to Base mainnet USDC).
# USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
# Base Sepolia RPC (for testnet dry runs)
# BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# Basescan API key (only needed for `hardhat verify`)
# BASESCAN_API_KEY=

# ── Optional: ownership handoff ──────────────────────────────────────────────
# Gnosis Safe (or any multisig) that becomes the contract owner right after deploy.
# Leave empty to keep ownership on the deployer EOA (NOT recommended for mainnet).
# SAFE_ADDRESS=0x9520269b506e02c357a712160979a3237C404fE6

# Chain id used when exporting the ABI to the frontend (8453 mainnet / 84532 sepolia)
# CHAIN_ID=8453
